<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Tri Clipper</string>
	<key>CFBundleExecutable</key><string>TriClipper</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundleIdentifier</key><string>nl.justinmeijer.triclipper</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>Tri Clipper</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0.1</string>
	<key>CFBundleVersion</key><string>10</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key><string>13.0</string>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<key>NSHumanReadableCopyright</key><string>Copyright © 2026 Justin Meijer. All rights reserved.</string>
	<key>SFSafariWebExtensionConverterVersion</key><string>15.4</string>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tri Clipper sends the page you choose to clip to the Trilium note server whose address you enter in its settings. That server is usually a computer on your own network — for example a Raspberry Pi or NAS at 192.168.1.22 — so reaching it needs local network access. Nothing is sent anywhere else.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Enough for a Trilium on the local network over plain http. A server
		     reached from outside the network has to be https; asking for
		     arbitrary loads instead would be a much larger claim to justify. -->
		<key>NSAllowsLocalNetworking</key><true/>
	</dict>
</dict>
</plist>
